{
  "name": "@aicacia/storage-client",
  "version": "0.1.0",
  "description": "Storage browser client over WebSockets",
  "keywords": [
    "aicacia",
    "storage",
    "client",
    "websocket"
  ],
  "author": "Nathan Faucett",
  "license": "(MIT OR Apache-2.0)",
  "readmeFilename": "README.md",
  "type": "module",
  "module": "esm",
  "main": "esm",
  "types": "types",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:esm": "tsc --project tsconfig.json",
    "build:browser": "rolldown -c",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:browser",
    "clean": "shx rm -rf esm browser types .nyc_output coverage tsconfig.tsbuildinfo",
    "test": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write ."
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "rolldown": "^1.1.5",
    "shx": "^0.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}