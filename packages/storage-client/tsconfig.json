{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "allowImportingTsExtensions": false,
    "importHelpers": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./esm",
    "declarationDir": "./types",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.*"]
}
