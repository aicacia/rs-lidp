{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "storage",
  "version": "0.1.0",
  "identifier": "com.aicacia.storage",
  "build": {
    "frontendDist": "../build",
    "devUrl": "https://storage-desktop.localhost:1337",
    "beforeDevCommand": "pnpm desktop:dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Storage",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
	"plugins": {
		"deep-link": {
			"mobile": [
				{
					"scheme": ["storage"],
					"appLink": false
				}
			],
			"desktop": {
				"schemes": ["storage"]
			}
		},
		"cli": {
			"description": "Local First Storage Application",
			"args": [
				{
					"name": "config",
					"short": "c",
					"takesValue": true,
					"description": "The config path to use"
				}
			]
		}
	}
}
